+void document::append_document_stylesheets()
+{
+	const auto doc = shared_from_this();
+	for (const auto& sheet : m_css)
+	{
+		media_query_list_list::ptr media;
+		if (!sheet.media.empty())
+		{
+			media = make_shared<media_query_list_list>();
+			media->add(parse_media_query_list(sheet.media, doc));
+		}
+		m_styles.parse_css_stylesheet(sheet.text, sheet.baseurl, doc, media);
+	}
+}
+
+void document::apply_document_author_styles()
+{
+	m_styles.sort_selectors();
+	update_media_lists(m_media);
+	apply_author_styles(*m_root);
+}
+
+void document::apply_author_styles(element& root)
+{
+	const auto visit_tags = [](const auto& visit, element& node, const auto& action) -> void {
+		if (auto* tag = dynamic_cast<html_tag*>(&node))
+			action(*tag);
+		for (const auto& child : node.children())
+			visit(visit, *child, action);
+	};
+	// Include generated nodes from the default stylesheet in the rollback baseline.
+	visit_tags(visit_tags, root, [](html_tag& tag) { tag.m_style.snapshot_defaults(); });
+	root.apply_stylesheet(m_styles);
+	visit_tags(visit_tags, root, [](html_tag& tag) { tag.apply_inline_style(); });
 }
 
