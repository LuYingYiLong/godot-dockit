+static bool matches_sibling_index(int index, int a, int b)
+{
+	const auto delta = static_cast<int64_t>(index) - b;
+	if (delta == 0) return true;
+	return a != 0 && (delta > 0) == (a > 0) && delta % a == 0;
+}
 
