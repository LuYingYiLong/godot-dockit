+static void remember_whitespace(css_token_vector& tokens)
+{
+	for (size_t index = 1; index < tokens.size(); ++index)
+	{
+		auto& token = tokens[index];
+		if (tokens[index - 1].type != WHITESPACE)
+			continue;
+		token.preceded_by_space = true;
+		if ((token.ch == '+' || token.ch == '-') && index + 1 < tokens.size() &&
+			tokens[index + 1].type == WHITESPACE)
+			token.spaced_operator = true;
+	}
+}
