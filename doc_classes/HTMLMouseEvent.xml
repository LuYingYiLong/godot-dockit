<?xml version="1.0" encoding="UTF-8" ?>
<class name="HTMLMouseEvent" inherits="HTMLEvent" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<brief_description>
		A pointer event for [code]mousedown[/code], [code]mouseup[/code], [code]click[/code], and [code]contextmenu[/code].
	</brief_description>
	<description>
		Carries the pointer position in the host [HTMLLabel]'s local coordinates and the modifier state at the time of the press or release.
	</description>
	<members>
		<member name="button" type="int" setter="set_button" getter="get_button">
			The mouse button that produced the event, using the [enum MouseButton] values.
		</member>
		<member name="buttons" type="int" setter="set_buttons" getter="get_buttons">
			The bit mask of buttons held when the event was produced.
		</member>
		<member name="position" type="Vector2" setter="set_position" getter="get_position">
			The pointer position in the host control's local coordinates.
		</member>
		<member name="shift_pressed" type="bool" setter="set_shift_pressed" getter="is_shift_pressed">
			Whether Shift was held.
		</member>
		<member name="ctrl_pressed" type="bool" setter="set_ctrl_pressed" getter="is_ctrl_pressed">
			Whether Ctrl was held.
		</member>
		<member name="alt_pressed" type="bool" setter="set_alt_pressed" getter="is_alt_pressed">
			Whether Alt was held.
		</member>
		<member name="meta_pressed" type="bool" setter="set_meta_pressed" getter="is_meta_pressed">
			Whether Meta was held.
		</member>
	</members>
</class>
